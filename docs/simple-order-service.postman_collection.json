          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/healthz",
            "description": "Liveness probe. Returns 200 with the standard envelope: {\"data\":{\"status\":\"ok\"}}."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                },
                {
                  "key": "X-Request-ID",
                  "value": "0199a0f2-4f6e-7d5b-8c1a-6b2d7e4f9a40"
                }
              ],
              "cookie": [],
              "body": "{\"data\":{\"status\":\"ok\"}}"
            }
          ]
        },
        {
          "name": "Readiness Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/readyz",
            "description": "Readiness probe: verifies the service's dependencies (PostgreSQL) are reachable, bounded at 2s. Returns 200 {\"data\":{\"status\":\"ready\"}} when ready, or 503 NOT_READY when a dependency is unavailable."
          },
          "response": [
            {
              "name": "200 Ready",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                },
                {
                  "key": "X-Request-ID",
                  "value": "0199a0f2-4f6e-7d5b-8c1a-6b2d7e4f9a40"
                }
              ],
              "cookie": [],
              "body": "{\"data\":{\"status\":\"ready\"}}"
            },
            {
              "name": "503 Not ready",
              "status": "Service Unavailable",
              "code": 503,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                },
                {
                  "key": "X-Request-ID",
                  "value": "0199a0f2-4f6e-7d5b-8c1a-6b2d7e4f9a40"
                }
              ],
              "cookie": [],
              "body": "{\"error\":{\"code\":\"NOT_READY\",\"message\":\"service dependencies are unavailable\",\"request_id\":\"0199a0f2-4f6e-7d5b-8c1a-6b2d7e4f9a40\"}}"
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.token) {",
                  "  pm.collectionVariables.set('token', body.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bene\",\n  \"email\": \"bene@example.com\",\n  \"password\": \"s3cret-pass\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/v1/auth/register",
            "description": "Creates an account and returns a JWT (stored in {{token}}). Uses the literal email bene@example.com — run this once before Login. Re-running with an existing email returns 409 EMAIL_ALREADY_EXISTS, so edit the email here (and in Login) to register another account. Response: {\"data\":{\"token\",\"token_type\",\"expires_at\",\"user\"}}."
          },
