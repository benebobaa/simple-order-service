# Copy to .env and adjust as needed. Loaded automatically in development.

APP_ENV=development
PORT=8080

# PostgreSQL connection string (required).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/orders?sslmode=disable

# Connection pool tuning (optional; leave blank to use the pgx default):
#   DB_MAX_CONNS         max open connections   (default: max(4, NumCPU))
#   DB_MIN_CONNS         connections kept warm  (default: 0)
#   DB_MAX_CONN_LIFETIME connection recycle age (default: 1h)
#   DB_MAX_CONN_IDLE_TIME idle eviction         (default: 30m)
# Keep instances × DB_MAX_CONNS below the server's max_connections (Postgres
# default: 100) to leave headroom for migrations and admin sessions.
DB_MAX_CONNS=
DB_MIN_CONNS=
DB_MAX_CONN_LIFETIME=
DB_MAX_CONN_IDLE_TIME=

# Run pending goose migrations automatically on application startup
AUTO_MIGRATE=true

# JWT signing secret (use a long random value in production)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_TTL=24h

# debug | info | warn | error
LOG_LEVEL=info
